-- ===== 2. Vehicle Anti-Collision (ghost) =====
local ghostRunning = false
local constraints = {}

local function destroyConstraint(c)
	constraints[c] = nil
	if c and c.Parent then c:Destroy() end
end

local function clearConstraints()
	for c in pairs(constraints) do
		pcall(destroyConstraint, c)
	end
	table.clear(constraints)
end

local function getVehiclesFolder()
	return Workspace:FindFirstChild("Vehicles")
end

local function getCurrentVehicle()
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	local vehicles = getVehiclesFolder()
	if not seat or not seat:IsA("VehicleSeat") or not vehicles then return nil end
	local obj = seat
	while obj and obj.Parent ~= vehicles do obj = obj.Parent end
	if obj and obj.Parent == vehicles and obj:IsA("Model") then return obj end
	return nil
end

local function addBaseParts(container, out)
	if not container then return end
	for _, o in ipairs(container:GetDescendants()) do
		if o:IsA("BasePart") then table.insert(out, o) end
	end
end

local function addWheelColliders(wheels, out)
	if not wheels then return end
	for _, w in ipairs(wheels:GetChildren()) do
		local c = w:FindFirstChild("Collider")
		if c and c:IsA("BasePart") then table.insert(out, c) end
	end
end

local function getVehicleColliders(vehicle)
	local res = {}
	local body = vehicle and vehicle:FindFirstChild("Body")
	if not body then return res end
	addBaseParts(body:FindFirstChild("Colliders"), res)
	addWheelColliders(vehicle:FindFirstChild("Wheels"), res)
	local trailer = body:FindFirstChild("Trailer")
	if trailer then
		addBaseParts(trailer:FindFirstChild("Colliders"), res)
		addWheelColliders(trailer:FindFirstChild("Wheels"), res)
	end
	return res
end

local function reconcileGhost()
	if not ghostRunning then return end
	local vehicles = getVehiclesFolder()
	local own = getCurrentVehicle()
	if not vehicles or not own then
		clearConstraints()
		return
	end
	local ownParts = getVehicleColliders(own)
	local desired = {}
	for _, other in ipairs(vehicles:GetChildren()) do
		if other:IsA("Model") and other ~= own then
			local otherParts = getVehicleColliders(other)
			for _, op in ipairs(ownParts) do
				if op.Parent then
					local map = desired[op]
					if not map then map = {} desired[op] = map end
					for _, tp in ipairs(otherParts) do
						if tp.Parent then map[tp] = true end
					end
				end
			end
		end
	end
	for c in pairs(constraints) do
		local map = c.Part0 and desired[c.Part0]
		if not map or not map[c.Part1] then
			destroyConstraint(c)
		else
			map[c.Part1] = nil
		end
	end
	for op, map in pairs(desired) do
		for tp in pairs(map) do
			local c = Instance.new("NoCollisionConstraint")
			c.Name = "__VehicleGhost"
			c.Part0 = op
			c.Part1 = tp
			c.Parent = op
			constraints[c] = true
		end
	end
end

startGhost = function()
	if ghostRunning then return true end
	ghostRunning = true
	task.spawn(function()
		while ghostRunning do
			pcall(reconcileGhost)
			task.wait(0.25)
		end
	end)
	return true
end

stopGhost = function()
	ghostRunning = false
	clearConstraints()
	return true
end

-- ===== 3. Anti PIT =====
local pitRunning = false
local disabledPit = {}

local function disableSignalConnections(signal, registry)
	local resolved = getconnections
	if type(resolved) ~= "function" then
		local ok, v = pcall(function()
			return (getgenv and getgenv().getconnections) or _G.getconnections
		end)
		resolved = ok and v or nil
	end
	if type(resolved) ~= "function" then
		return false, "getconnections unavailable"
	end
	local ok, cons = pcall(resolved, signal)
	if not ok or type(cons) ~= "table" then
		return false, "Cannot inspect event connections"
	end
	for _, c in ipairs(cons) do
		if not registry[c] then
			local disabled = pcall(function() c:Disable() end)
			if disabled then registry[c] = true end
		end
	end
	return true
end

local function refreshAntiPit()
	local remotes = ReplicatedStorage:FindFirstChild("__remotes")
	local vs = remotes and remotes:FindFirstChild("VehicleService")
	local remote = vs and vs:FindFirstChild("VehiclePitManeuver")
	if not remote or not remote:IsA("RemoteEvent") then
		return false, "VehiclePitManeuver remote not found"
	end
	return disableSignalConnections(remote.OnClientEvent, disabledPit)
end

startAntiPit = function()
	if pitRunning then return true end
	local ok, err = refreshAntiPit()
	if not ok then
		return false, err
	end
	pitRunning = true
	task.delay(0.75, function()
		if pitRunning then refreshAntiPit() end
	end)
	return true
end

stopAntiPit = function()
	pitRunning = false
	for c in pairs(disabledPit) do
		pcall(function() c:Enable() end)
		disabledPit[c] = nil
	end
	return true
end

-- ===== Драг + клики =====
local dragging, dragStart, startPos

local function onPress(input, isRight)
	dragging = true
	dragStart = input.Position
	startPos = button.Position
	local moved = false

	local cc
	cc = input.Changed:Connect(function()
		if input.UserInputState ~= Enum.UserInputState.End then return end
		dragging = false
		cc:Disconnect()
		if moved then return end
		if isRight then
			values.antiPit = not values.antiPit
			if values.antiPit then
				local ok, err = startAntiPit()
				if not ok then
					values.antiPit = false
					warn("[CarunoGhostBtn] AntiPIT: " .. tostring(err))
				end
			else
				stopAntiPit()
			end
		else
			values.ghost = not values.ghost
			if values.ghost then startGhost() else stopGhost() end
		end
		refresh()
	end)

	local mc
	mc = UserInputService.InputChanged:Connect(function(mi)
		if not dragging then mc:Disconnect() return end
		if mi.UserInputType ~= Enum.UserInputType.MouseMovement
			and mi.UserInputType ~= Enum.UserInputType.Touch then return end
		local d = mi.Position - dragStart
		if math.abs(d.X) > 3 or math.abs(d.Y) > 3 then moved = true end
		button.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end)
end

button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		onPress(input, false)
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		onPress(input, true)
	end
end)

button.MouseEnter:Connect(function()
	tip.Visible = true
	refresh()
end)
button.MouseLeave:Connect(function()
	tip.Visible = false
end)

-- ===== API =====
_G.CarunoGhostBtn = {
	Destroy = function()
		stopGhost()
		stopAntiPit()
		gui:Destroy()
		_G.CarunoGhostBtn = nil
	end,
	ToggleGhost = function()
		values.ghost = not values.ghost
		if values.ghost then startGhost() else stopGhost() end
		refresh()
	end,
	ToggleAntiPit = function()
		values.antiPit = not values.antiPit
		if values.antiPit then startAntiPit() else stopAntiPit() end
		refresh()
	end,
	IsGhostOn = function() return values.ghost end,
	IsAntiPitOn = function() return values.antiPit end,
}

refresh()
return _G.CarunoGhostBtn