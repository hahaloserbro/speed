-- CarunoSpeedBtn v2 — ускорение авто + бесконечный бензин
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

if _G.CarunoSpeedBtn and type(_G.CarunoSpeedBtn.Destroy) == "function" then
	pcall(_G.CarunoSpeedBtn.Destroy)
end
local old = playerGui:FindFirstChild("CarunoSpeedBtn")
if old then old:Destroy() end

local VehicleUtil
do
	local ok, module = pcall(function()
		return require(
			ReplicatedStorage
				:WaitForChild("SharedModules", 10)
				:WaitForChild("VehicleUtil", 10)
		)
	end)
	if ok and type(module) == "table" then
		VehicleUtil = module
	end
end

local values = {
	speedEnabled = false,
	fuelEnabled = false,
	speedMultiplier = 150,
	minSpeed = 100,
	maxSpeed = 400,
	step = 10,
}

