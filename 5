-- ===== Бинд утилиты =====
local MODIFIER_KEYS = {
	[Enum.KeyCode.LeftControl] = true,
	[Enum.KeyCode.RightControl] = true,
	[Enum.KeyCode.LeftShift] = true,
	[Enum.KeyCode.RightShift] = true,
	[Enum.KeyCode.LeftAlt] = true,
	[Enum.KeyCode.RightAlt] = true,
}

local function getMods()
	return {
		ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
		shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightShift),
		alt = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt),
	}
end

local function bindToString(b)
	if not b then return "none" end
	if b.kind == "mouse" then
		if b.value == Enum.UserInputType.MouseButton2 then return "RMB" end
		if b.value == Enum.UserInputType.MouseButton3 then return "MMB" end
		if b.value == Enum.UserInputType.MouseButton1 then return "LMB" end
		return "Mouse"
	end
	local parts = {}
	if b.mods.ctrl then table.insert(parts, "Ctrl") end
	if b.mods.shift then table.insert(parts, "Shift") end
	if b.mods.alt then table.insert(parts, "Alt") end
	table.insert(parts, b.value.Name)
	return table.concat(parts, "+")
end

local function isBindInput(input)
	if not bind then return false end
	if bind.kind == "mouse" then
		return input.UserInputType == bind.value
	end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return false end
	if input.KeyCode ~= bind.value then return false end
	local m = getMods()
	if m.ctrl ~= bind.mods.ctrl then return false end
	if m.shift ~= bind.mods.shift then return false end
	if m.alt ~= bind.mods.alt then return false end
	return true
end

local function refresh()
	if awaitingBind then
		button.BackgroundColor3 = Color3.fromRGB(82, 66, 22)
		stroke.Color = Color3.fromRGB(228, 178, 84)
	elseif beamOn then
		button.BackgroundColor3 = Color3.fromRGB(22, 82, 52)
		stroke.Color = Color3.fromRGB(88, 214, 134)
	else
		button.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
		stroke.Color = Color3.fromRGB(90, 90, 100)
	end
	activeDot.BackgroundColor3 = beamOn
		and Color3.fromRGB(88, 214, 134)
		or Color3.fromRGB(70, 70, 78)
	if awaitingBind then
		bindDot.BackgroundColor3 = Color3.fromRGB(228, 178, 84)
	elseif bind then
		bindDot.BackgroundColor3 = Color3.fromRGB(88, 200, 228)
	else
		bindDot.BackgroundColor3 = Color3.fromRGB(70, 70, 78)
	end
	local keyText
	if awaitingBind then
		keyText = "press key or MMB | RMB/Esc cancel"
	else
		keyText = bindToString(bind)
	end
	tip.Text = string.format("Beam:%s | Key:%s", beamOn and "ON" or "OFF", keyText)
end

local function enterBind()
	if awaitingBind then return end
	bindBackup = bind and {
		kind = bind.kind, value = bind.value,
		mods = { ctrl = bind.mods.ctrl, shift = bind.mods.shift, alt = bind.mods.alt },
	} or nil
	awaitingBind = true
	beamOn = false
	refresh()
end

local function cancelBind()
	if not awaitingBind then return end
	bind = bindBackup
	bindBackup = nil
	awaitingBind = false
	refresh()
end

local function clearBind()
	awaitingBind = false
	bindBackup = nil
	bind = nil
	beamOn = false
	refresh()
end

-- ===== Луч =====
local beam
local function destroyBeam()
	if beam and beam.Parent then beam:Destroy() end
	beam = nil
end
local function ensureBeam()
	if beam and beam.Parent then return beam end
	local b = Instance.new("Part")
	b.Name = "CarunoBeamBeam"
	b.Anchored = true
	b.CanCollide = false
	b.CanQuery = false
	b.CanTouch = false
	b.Material = Enum.Material.Neon
	b.Color = Color3.fromRGB(255, 255, 255)
	b.Transparency = 0.2
	b.Shape = Enum.PartType.Cylinder
	b.Size = Vector3.new(1, 0.4, 0.4)
	b.Parent = Workspace
	beam = b
	return b
end

local function getCursorGround()
	local hit = mouse.Hit
	if hit then return hit.Position end
	local ray = mouse.UnitRay
	if ray and ray.Direction.Y < -0.01 then
		local t = -ray.Origin.Y / ray.Direction.Y
		if t > 0 then return ray.Origin + ray.Direction * t end
	end
	return nil
end

local function getDrivenVehicle()
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end
	-- Явно проверяем, сидим ли в VehicleSeat
	local seat = hum.SeatPart
	if not seat or not seat:IsA("VehicleSeat") then
		return nil
	end
	if VehicleUtil then
		local ok, v = pcall(function()
			return VehicleUtil:GetHumanoidDrivenVehicle(hum)
		end)
		if ok and v then return v end
	end
	local vehicles = Workspace:FindFirstChild("Vehicles")
	if not vehicles then return nil end
	local obj = seat
	while obj and obj.Parent ~= vehicles do obj = obj.Parent end
	if obj and obj.Parent == vehicles and obj:IsA("Model") then return obj end
	return nil
end

local freezeConn
local function teleportTo(pos)
	local vehicle = getDrivenVehicle()

	if vehicle then
		-- === В машине: телепортируем машину ===
		local pivot = vehicle:GetPivot()
		local newPivot = CFrame.new(pos + Vector3.new(0, 3, 0)) * pivot.Rotation
		pcall(function() vehicle:PivotTo(newPivot) end)

		if freezeConn then freezeConn:Disconnect() end
		local startTime = os.clock()
		freezeConn = RunService.Heartbeat:Connect(function()
			if os.clock() - startTime > 0.5 then
				freezeConn:Disconnect() freezeConn = nil
				return
			end
			if not vehicle or not vehicle.Parent then
				freezeConn:Disconnect() freezeConn = nil
				return
			end
			pcall(function()
				for _, part in ipairs(vehicle:GetDescendants()) do
					if part:IsA("BasePart") then
						part.AssemblyLinearVelocity = Vector3.zero
						part.AssemblyAngularVelocity = Vector3.zero
					end
				end
			end)
		end)
	else
		-- === Вне машины: телепортируем персонажа ===
		local ch = player.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		if not hrp then
			warn("[CarunoBeamBtn] No character to teleport")
			return
		end
		-- Ставим чуть выше пола, чтобы не провалиться
		local targetPos = pos + Vector3.new(0, 4, 0)
		pcall(function()
			ch:PivotTo(CFrame.new(targetPos) * (hrp.CFrame - hrp.CFrame.Position))
		end)

		-- Фиксация чтобы не отбросило
		local startTime = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function()
			if os.clock() - startTime > 0.25 then
				conn:Disconnect()
				return
			end
			if hrp and hrp.Parent then
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
		end)
	end
end

RunService.RenderStepped:Connect(function()
	if not beamOn then
		if beam then destroyBeam() end
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		if beam then destroyBeam() end
		return
	end
	local groundPos = getCursorGround()
	if not groundPos then return end
	local dist = (groundPos - hrp.Position).Magnitude
	local length = math.clamp(10 * (1 + dist / 30), 10, 250)
	local width  = math.clamp(0.4 * (1 + dist / 150), 0.4, 4)
	local b = ensureBeam()
	b.Size = Vector3.new(length, width, width)
	b.CFrame = CFrame.new(groundPos + Vector3.new(0, length / 2, 0))
		* CFrame.Angles(0, 0, math.pi / 2)
end)

-- ===== Глобальный ввод =====
UserInputService.InputBegan:Connect(function(input, gp)
	if UserInputService:GetFocusedTextBox() then return end

	if awaitingBind then
		if input.UserInputType == Enum.UserInputType.Keyboard
			and input.KeyCode == Enum.KeyCode.Escape then
			cancelBind() return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if MODIFIER_KEYS[input.KeyCode] then return end
			bind = { kind = "key", value = input.KeyCode, mods = getMods() }
			bindBackup = nil
			awaitingBind = false
			refresh() return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton3 then
			bind = { kind = "mouse", value = Enum.UserInputType.MouseButton3,
				mods = { ctrl = false, shift = false, alt = false } }
			bindBackup = nil
			awaitingBind = false
			refresh() return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseButton2 then
			if gp then return end
			cancelBind() return
		end
		return
	end

	if gp then return end

	if beamOn and input.UserInputType == Enum.UserInputType.MouseButton1 then
		local groundPos = getCursorGround()
		if groundPos then teleportTo(groundPos) end
		beamOn = false
		destroyBeam()
		refresh()
		return
	end

	if isBindInput(input) then
		beamOn = not beamOn
		if not beamOn then destroyBeam() end
		refresh()
	end
end)

-- ===== Кнопка: драг + клики =====
local dragging = false
local dragStart, startPos
local pressKind = nil
local moved = false

button.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.MouseButton2
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	pressKind = input.UserInputType == Enum.UserInputType.MouseButton2 and "right" or "left"
	dragging = true
	moved = false
	dragStart = input.Position
	startPos = button.Position
	local cc
	cc = input.Changed:Connect(function()
		if input.UserInputState ~= Enum.UserInputState.End then return end
		cc:Disconnect()
		dragging = false
		if moved then pressKind = nil return end

		if pressKind == "right" then
			if awaitingBind then cancelBind() else enterBind() end
		elseif pressKind == "left" then
			if awaitingBind then
				clearBind()
			else
				beamOn = not beamOn
				if not beamOn then destroyBeam() end
				refresh()
			end
		end
		pressKind = nil
	end)
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local d = input.Position - dragStart
	if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then moved = true end
	if moved then
		button.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end
end)

button.MouseEnter:Connect(function() tip.Visible = true refresh() end)
button.MouseLeave:Connect(function() tip.Visible = false end)

_G.CarunoBeamBtn = {
	Destroy = function()
		destroyBeam()
		if freezeConn then freezeConn:Disconnect() freezeConn = nil end
		gui:Destroy()
		_G.CarunoBeamBtn = nil
	end,
	SetBindKey = function(k, m)
		bind = { kind = "key", value = k, mods = m or { ctrl=false, shift=false, alt=false } }
		refresh()
	end,
	SetBindMouse = function(t)
		bind = { kind = "mouse", value = t, mods = { ctrl=false, shift=false, alt=false } }
		refresh()
	end,
	ClearBind = clearBind,
	GetBind = function() return bind end,
	IsBeamOn = function() return beamOn end,
	IsAwaitingBind = function() return awaitingBind end,
	GetBeam = function() return beam end,
}

refresh()
return _G.CarunoBeamBtn