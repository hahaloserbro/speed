	pcall(_G.CarunoBeamBtn.Destroy)
end
do
	local g = playerGui:FindFirstChild("CarunoBeamBtn")
	if g then g:Destroy() end
	local b = Workspace:FindFirstChild("CarunoBeamBeam")
	if b then b:Destroy() end
end

