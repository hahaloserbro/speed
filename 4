-- ===== Бинд =====
local MODIFIER_KEYS = {
	[Enum.KeyCode.LeftControl] = true,
	[Enum.KeyCode.RightControl] = true,
	[Enum.KeyCode.LeftShift] = true,
	[Enum.KeyCode.RightShift] = true,
	[Enum.KeyCode.LeftAlt] = true,
	[Enum.KeyCode.RightAlt] = true,
}

local function getMods()
	return {
		ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
		shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightShift),
		alt = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt),
	}
end

local function cloneBind(b)
	if not b then return nil end
	return { key = b.key, mods = { ctrl = b.mods.ctrl, shift = b.mods.shift, alt = b.mods.alt } }
end

local function bindToString(b)
	if not b then return "none" end
	local parts = {}
	if b.mods.ctrl then table.insert(parts, "Ctrl") end
	if b.mods.shift then table.insert(parts, "Shift") end
	if b.mods.alt then table.insert(parts, "Alt") end
	table.insert(parts, b.key.Name)
	return table.concat(parts, "+")
end

-- Проверка: реально ли сейчас зажат бинд (и клавиша, и модификаторы)
local function isBindDown()
	if not bind then return false end
	if not UserInputService:IsKeyDown(bind.key) then return false end
	local m = getMods()
	if m.ctrl ~= bind.mods.ctrl then return false end
	if m.shift ~= bind.mods.shift then return false end
	if m.alt ~= bind.mods.alt then return false end
	return true
end

local function refreshTip()
	local keyText
	if awaitingBind then
		keyText = "LMB=clear | RMB=keep | press key"
	else
		keyText = bindToString(bind)
	end
	tip.Text = string.format(
		"Brake:%s | Key:%s",
		values.enabled and "ON" or "OFF",
		keyText
	)
end

refresh = function()
	if awaitingBind then
		button.BackgroundColor3 = Color3.fromRGB(82, 66, 22)
		stroke.Color = Color3.fromRGB(228, 178, 84)
	elseif values.enabled then
		button.BackgroundColor3 = Color3.fromRGB(82, 22, 22)
		stroke.Color = Color3.fromRGB(228, 88, 88)
	else
		button.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
		stroke.Color = Color3.fromRGB(90, 90, 100)
	end
	activeDot.BackgroundColor3 = values.braking
		and Color3.fromRGB(228, 88, 88)
		or Color3.fromRGB(70, 70, 78)
	if awaitingBind then
		bindDot.BackgroundColor3 = Color3.fromRGB(228, 178, 84)
	elseif bind then
		bindDot.BackgroundColor3 = Color3.fromRGB(88, 200, 228)
	else
		bindDot.BackgroundColor3 = Color3.fromRGB(70, 70, 78)
	end
	refreshTip()
end

local function enterBindMode()
	bindBackup = cloneBind(bind)
	awaitingBind = true
	refresh()
end

local function cancelBindKeep()
	bind = bindBackup
	bindBackup = nil
	awaitingBind = false
	refresh()
end

local function cancelBindClear()
	bind = nil
	bindBackup = nil
	awaitingBind = false
	refresh()
end

-- ===== Логика =====
local function getDrivenVehicle()
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then return nil, nil end
	local vehicle
	if VehicleUtil then
		local ok, v = pcall(function()
			return VehicleUtil:GetHumanoidDrivenVehicle(hum)
		end)
		if ok and v then vehicle = v end
	end
	if not vehicle then
		local seat = hum.SeatPart
		local vehicles = Workspace:FindFirstChild("Vehicles")
		if seat and vehicles then
			local obj = seat
			while obj and obj.Parent ~= vehicles do obj = obj.Parent end
			if obj and obj.Parent == vehicles and obj:IsA("Model") then
				vehicle = obj
			end
		end
	end
	if not vehicle then return nil, nil end
	local root = vehicle:FindFirstChild("Root")
	if not (root and root:IsA("BasePart")) then
		root = vehicle.PrimaryPart or (hum.SeatPart and hum.SeatPart.AssemblyRootPart)
	end
	return vehicle, root
end

local function applyBrake()
	local vehicle, root = getDrivenVehicle()
	if not root then return false end

	pcall(function()
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)

	if vehicle then
		for _, part in ipairs(vehicle:GetDescendants()) do
			if part:IsA("BasePart") then
				pcall(function()
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end)
			end
		end
	end
	return true
end

RunService.Heartbeat:Connect(function()
	-- Всегда синхронизируем keyHeld с реальным состоянием клавиш.
	-- Это устраняет любые пропуски InputEnded/InputBegan.
	if bind and not awaitingBind then
		keyHeld = isBindDown()
	end

	local active
	if bind then
		active = keyHeld
	else
		active = values.enabled
	end

	if values.enabled ~= active then
		values.enabled = active
		refresh()
	end

	if active then
		local ok = applyBrake()
		if values.braking ~= ok then
			values.braking = ok
			refresh()
		end
	else
		if values.braking then
			values.braking = false
			refresh()
		end
	end
end)

-- ===== Ввод клавиатуры — только для бинда =====
UserInputService.InputBegan:Connect(function(input, gp)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if UserInputService:GetFocusedTextBox() then return end
	if not awaitingBind then return end

	if input.KeyCode == Enum.KeyCode.Escape then
		cancelBindKeep()
		return
	end
	if MODIFIER_KEYS[input.KeyCode] then return end

	bind = { mods = getMods(), key = input.KeyCode }
	bindBackup = nil
	awaitingBind = false
	keyHeld = false  -- Heartbeat сам поднимет, если клавиша ещё зажата
	refresh()
end)

-- ===== Драг + клики =====
local dragging, dragStart, startPos
local function onPress(input, kind)
	dragging = true
	dragStart = input.Position
	startPos = button.Position
	local moved = false

	local cc
	cc = input.Changed:Connect(function()
		if input.UserInputState ~= Enum.UserInputState.End then return end
		dragging = false
		cc:Disconnect()
		if moved then return end

		if awaitingBind then
			if kind == "left" then
				cancelBindClear()
			else
				cancelBindKeep()
			end
			return
		end

		if kind == "left" then
			if bind then return end  -- если есть бинд, ЛКМ не переключает
			values.enabled = not values.enabled
			refresh()
		elseif kind == "right" then
			enterBindMode()
		elseif kind == "middle" then
			bind = nil
			refresh()
		end
	end)

	local mc
	mc = UserInputService.InputChanged:Connect(function(mi)
		if not dragging then mc:Disconnect() return end
		if mi.UserInputType ~= Enum.UserInputType.MouseMovement
			and mi.UserInputType ~= Enum.UserInputType.Touch then return end
		local d = mi.Position - dragStart
		if math.abs(d.X) > 3 or math.abs(d.Y) > 3 then moved = true end
		button.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end)
end

button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		onPress(input, "left")
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		onPress(input, "right")
	elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
		onPress(input, "middle")
	end
end)

-- ===== Hover =====
button.MouseEnter:Connect(function()
	tip.Visible = true
	refreshTip()
end)
button.MouseLeave:Connect(function()
	tip.Visible = false
end)

-- ===== API =====
_G.CarunoBrakeBtn = {
	Destroy = function()
		gui:Destroy()
		_G.CarunoBrakeBtn = nil
	end,
	SetBind = function(keyCode, mods)
		bind = { key = keyCode, mods = mods or { ctrl = false, shift = false, alt = false } }
		refresh()
	end,
	ClearBind = function()
		bind = nil
		keyHeld = false
		refresh()
	end,
	GetBind = function() return bind end,
	IsOn = function() return values.enabled end,
	IsBraking = function() return values.braking end,
	IsKeyHeld = function() return keyHeld end,
	IsAwaitingBind = function() return awaitingBind end,
}

refresh()
return _G.CarunoBrakeBtn