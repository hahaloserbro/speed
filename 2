-- CarunoGateBtn — только шлагбаумы
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

if _G.CarunoGateBtn and _G.CarunoGateBtn.Destroy then
	pcall(_G.CarunoGateBtn.Destroy)
end
local old = playerGui:FindFirstChild("CarunoGateBtn")
if old then old:Destroy() end

-- ===== Состояние =====
local values = { enabled = false }
local running = false
local constraints = {}

-- forward declarations
local refresh, start, stop, reconcile, collectBarriers, getMyParts, isBarrier

-- ===== UI =====
local gui = Instance.new("ScreenGui")
gui.Name = "CarunoGateBtn"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = playerGui

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(60, 60)
button.Position = UDim2.new(0.5, 10, 0.5, -120)
button.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
button.BackgroundTransparency = 0.25
button.BorderSizePixel = 0
button.Text = ""
button.AutoButtonColor = false
button.Parent = gui

Instance.new("UICorner", button).CornerRadius = UDim.new(0, 14)
local stroke = Instance.new("UIStroke", button)
stroke.Color = Color3.fromRGB(90, 90, 100)
stroke.Thickness = 1
stroke.Transparency = 0.4

local icon = Instance.new("TextLabel", button)
icon.BackgroundTransparency = 1
icon.Size = UDim2.fromScale(0.75, 0.75)
icon.Position = UDim2.fromScale(0.125, 0.125)
icon.Text = "🚧"
icon.TextColor3 = Color3.fromRGB(255, 255, 255)
icon.TextTransparency = 0.5
icon.TextScaled = true
icon.Font = Enum.Font.GothamBold

-- ===== Логика =====
refresh = function()
	if values.enabled then
		button.BackgroundColor3 = Color3.fromRGB(22, 82, 52)
		stroke.Color = Color3.fromRGB(88, 214, 134)
	else
		button.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
		stroke.Color = Color3.fromRGB(90, 90, 100)
	end
end

isBarrier = function(p)
	if not p:IsA("BasePart") or not p.CanCollide then return false end
	local ok, g = pcall(function() return p.CollisionGroup end)
	return ok and g == "GateBarrier"
end

collectBarriers = function()
	local parts = {}
	for _, gate in ipairs(CollectionService:GetTagged("Gate")) do
		if gate:IsDescendantOf(Workspace) then
			if isBarrier(gate) then table.insert(parts, gate) end
			for _, d in ipairs(gate:GetDescendants()) do
				if isBarrier(d) then table.insert(parts, d) end
			end
		end
	end
	if #parts == 0 then
		for _, o in ipairs(Workspace:GetDescendants()) do
			if isBarrier(o) then table.insert(parts, o) end
		end
	end
	return parts
end

getMyParts = function()
	local parts = {}
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	local vehicles = Workspace:FindFirstChild("Vehicles")
	if seat and vehicles then
		local v = seat
		while v and v.Parent ~= vehicles do v = v.Parent end
		if v and v:IsA("Model") then
			local body = v:FindFirstChild("Body")
			if body then
				local col = body:FindFirstChild("Colliders")
				if col then
					for _, p in ipairs(col:GetDescendants()) do
						if p:IsA("BasePart") then table.insert(parts, p) end
					end
				end
			end
			local wheels = v:FindFirstChild("Wheels")
			if wheels then
				for _, w in ipairs(wheels:GetChildren()) do
					local c = w:FindFirstChild("Collider")
					if c and c:IsA("BasePart") then table.insert(parts, c) end
				end
			end
			local root = v.PrimaryPart or v:FindFirstChild("Root")
			if root and root:IsA("BasePart") then table.insert(parts, root) end
		end
	end
	if ch then
		for _, p in ipairs(ch:GetDescendants()) do
			if p:IsA("BasePart") then table.insert(parts, p) end
		end
	end
	return parts
end

reconcile = function()
	if not running then return end
	local mine = getMyParts()
	local barriers = collectBarriers()
	if #mine == 0 or #barriers == 0 then
		for c in pairs(constraints) do
			if c.Parent then c:Destroy() end
			constraints[c] = nil
		end
		return
	end
	local desired = {}
	for _, m in ipairs(mine) do
		if m.Parent then
			desired[m] = desired[m] or {}
			for _, b in ipairs(barriers) do
				if b.Parent then desired[m][b] = true end
			end
		end
	end
	for c in pairs(constraints) do
		local map = c.Part0 and desired[c.Part0]
		if not map or not map[c.Part1] then
			if c.Parent then c:Destroy() end
			constraints[c] = nil
		else
			map[c.Part1] = nil
		end
	end
	for m, map in pairs(desired) do
		for b in pairs(map) do
			local c = Instance.new("NoCollisionConstraint")
			c.Part0 = m
			c.Part1 = b
			c.Parent = m
			constraints[c] = true
		end
	end
end

start = function()
	if running then return end
	running = true
	task.spawn(function()
		while running do
			pcall(reconcile)
			task.wait(0.5)
		end
	end)
end

stop = function()
	running = false
	for c in pairs(constraints) do
		if c.Parent then c:Destroy() end
	end
	table.clear(constraints)
end

-- ===== Драг + клик =====
local dragging, dragStart, startPos
button.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then return end
	dragging = true
	dragStart = input.Position
	startPos = button.Position
	local moved = false
	local cc
	cc = input.Changed:Connect(function()
		if input.UserInputState ~= Enum.UserInputState.End then return end
		dragging = false
		cc:Disconnect()
		if not moved then
			values.enabled = not values.enabled
			refresh()
			if values.enabled then start() else stop() end
		end
	end)
	local mc
	mc = UserInputService.InputChanged:Connect(function(mi)
		if not dragging then mc:Disconnect() return end
		if mi.UserInputType ~= Enum.UserInputType.MouseMovement
			and mi.UserInputType ~= Enum.UserInputType.Touch then return end
		local d = mi.Position - dragStart
		if math.abs(d.X) > 3 or math.abs(d.Y) > 3 then moved = true end
		button.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end)
end)

-- ===== API =====
_G.CarunoGateBtn = {
	Destroy = function()
		running = false
		stop()
		gui:Destroy()
		_G.CarunoGateBtn = nil
	end,
	Toggle = function()
		values.enabled = not values.enabled
		refresh()
		if values.enabled then start() else stop() end
	end,
	IsOn = function() return values.enabled end,
}

refresh()
return _G.CarunoGateBtn